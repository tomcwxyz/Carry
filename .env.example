# Mobile client
EXPO_PUBLIC_CARRY_API_URL=

# Server
DATABASE_URL=
OPENAI_API_KEY=

# Server-to-server executor callbacks. Required before any external executor can report attempted/completed/failed actions or wake a waiting case.
CARRY_EXECUTOR_SECRET=

# Optional: retained for later Vercel AI Gateway-backed workers. Current case understanding and research use OPENAI_API_KEY directly.
AI_GATEWAY_API_KEY=

# Optional overrides
CARRY_CASE_MODEL=gpt-5.6-luna
CARRY_RESEARCH_MODEL=gpt-5.6-luna
CARRY_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
